  <vhdl appearance="logisim_evolution" name="vote25">library ieee;
use ieee.std_logic_1164.all;

-- Problem 4: a strict majority of 25 voters requires at least 13 votes.
entity vote25 is
    port (
        vt     : in  std_logic_vector(25 downto 1);
        result : out std_logic
    );
end entity vote25;

architecture rtl of vote25 is
begin
    process(vt)
        variable sum : integer range 0 to 25;
    begin
        sum := 0;
        for i in vt'range loop
            if vt(i) = '1' then
                sum := sum + 1;
            end if;
        end loop;

        if sum &gt;= 13 then
            result &lt;= '1';
        else
            result &lt;= '0';
        end if;
    end process;
end architecture rtl;
</vhdl>
  <circuit name="P4_vote25">
    <a name="appearance" val="logisim_evolution" />
    <a name="circuit" val="P4_vote25" />
    <a name="circuitnamedboxfixedsize" val="true" />
    <a name="simulationFrequency" val="1.0" />
    <comp lib="0" loc="(150,200)" name="Pin">
      <a name="appearance" val="NewPins" />
      <a name="initial" val="0x1fff" />
      <a name="label" val="votes" />
      <a name="width" val="25" />
    </comp>
    <comp lib="0" loc="(650,200)" name="Pin">
      <a name="appearance" val="NewPins" />
      <a name="facing" val="west" />
      <a name="label" val="result" />
      <a name="labelloc" val="north" />
      <a name="type" val="output" />
    </comp>
    <comp loc="(500,200)" name="vote25" />
    <wire from="(150,200)" to="(280,200)" />
    <wire from="(500,200)" to="(650,200)" />
  </circuit>
